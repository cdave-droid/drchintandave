# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Admin (protect /api/medduel/admin and /api/medduel/scrape)
ADMIN_SECRET=change-this-to-a-secret-passphrase

# Payload CMS (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your-payload-secret-min-32-chars

# Vercel Blob (from Vercel dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Google Apps Script endpoints (optional — contact/preorder forms)
NEXT_PUBLIC_FORM_URL=https://script.google.com/macros/s/your-script-id/exec
BOOK_WAITLIST_URL=https://script.google.com/macros/s/your-script-id/exec
