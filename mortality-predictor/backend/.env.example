# MortPred API Configuration
# Copy to .env and fill in values

# LLM Agent Configuration (pick one):

# Option 1: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 2: OpenAI-compatible API (OpenAI, Ollama, vLLM, etc.)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Option 3: No API key = uses rule-based fallback agent (works offline)

# CORS: comma-separated list of allowed frontend origins
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://drchintandave.com
